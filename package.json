{
  "name": "traceback",
  "version": "0.3.0",
  "description": "Local-first evidence trail: connect the sources, notes, commands and file changes behind every decision.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check",
    "check:extension": "node scripts/validate-extension.mjs",
    "check": "npm run typecheck && npm test && npm run check:icons && npm run check:extension && vite build"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
